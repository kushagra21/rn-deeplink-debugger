#!/usr/bin/env node
// Test double for the Expo CLI: supports only `expo config --json`.
const path = require("path");
if (process.argv[2] !== "config" || !process.argv.includes("--json")) process.exit(2);
const exported = require(path.join(process.cwd(), "app.config.js"));
const config = typeof exported === "function" ? exported({ config: {} }) : exported;
console.log("env: load .env"); // the real CLI can print log lines before the JSON
console.log(JSON.stringify(config, null, 2));
