{
  "name": "rn-deeplink",
  "version": "0.1.0",
  "description": "Find out why a deep link or universal/app link does not open your React Native app, and test links on simulators, emulators and devices.",
  "license": "MIT",
  "author": "Kushagra Sinha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kushagra21/rn-deeplink-debugger.git"
  },
  "homepage": "https://github.com/kushagra21/rn-deeplink-debugger#readme",
  "bugs": "https://github.com/kushagra21/rn-deeplink-debugger/issues",
  "type": "module",
  "bin": {
    "rn-deeplink": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demos": "npm run build && node scripts/record-demos.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "deep-link",
    "universal-links",
    "app-links",
    "apple-app-site-association",
    "assetlinks",
    "android-app-links",
    "ios-universal-links",
    "deeplink",
    "debugging",
    "simulator",
    "adb",
    "cli"
  ],
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "picocolors": "^1.1.1",
    "plist": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
